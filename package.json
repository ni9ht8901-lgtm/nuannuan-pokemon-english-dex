{
  "name": "letter-transform-station",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check:mvp": "node scripts/check-mvp.mjs",
    "growth:discover": "node nuannuan-growth-center/scripts/discover-projects/discover.mjs --workspace . --output nuannuan-growth-center",
    "growth:test": "npx tsc -p nuannuan-growth-center/packages/growth-sdk/tsconfig.json && node --test nuannuan-growth-center/tests/*.test.mjs",
    "growth:admin:build": "npx tsc -p nuannuan-growth-center/apps/admin/tsconfig.json && npx vite build nuannuan-growth-center/apps/admin",
    "growth:check": "npm run growth:test && npm run growth:admin:build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite-plugin-pwa": "^0.21.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
